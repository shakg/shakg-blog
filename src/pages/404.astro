---

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'Page Not Found';
---

<BaseLayout title={pageTitle} description="Page not found">
  <Header />
  <main class="container">
    <div class="not-found">
      <h1>404</h1>
      <p>Looks like this page wandered off into the woods.</p>
      <a href="/">← Return home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found h1 {
    margin: 0 0 1rem;
  }

  .not-found p {
    color: var(--color-secondary);
    margin-bottom: 2rem;
  }
</style>
