---

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header-inner container">
    <a href="/" class="logo">Ishak's Thoughts</a>
    <nav>
      <a href="/" class:list={['nav-link', { active: currentPath === '/' }]}>Writing</a>
      <a href="/about" class:list={['nav-link', { active: currentPath === '/about' }]}>About</a>
    </nav>
  </div>
</header>

<style>
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 3.5rem;
    padding-bottom: 4rem;
  }

  .logo {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }
  }
</style>
