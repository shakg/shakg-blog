---

import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'thoughts'>;
}

const { post } = Astro.props;
const { title, pubDate } = post.data;
---

<li class="post-row">
  <a href={`/thoughts/${post.slug}`} class="post-title">{title}</a>
  <time datetime={pubDate.toISOString()} class="post-date">
    {pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
  </time>
</li>

<style>
  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.5rem 0;
    margin: 0;
  }

  .post-title {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-title:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
  }

  .post-date {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
