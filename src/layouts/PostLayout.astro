---

import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TagPill from '../components/TagPill.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'thoughts'>;
  readingTime: string;
}

const { post, readingTime } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="container">
    <article>
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span class="separator">·</span>
          <span>{readingTime}</span>
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <TagPill tag={tag} />
          ))}
        </div>
      )}
    </article>
    <nav class="post-nav">
      <a href="/">← Back to all posts</a>
    </nav>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 3rem;
  }

  .post-header h1 {
    margin: 0 0 0.75rem;
  }

  .post-meta {
    font-size: 0.875rem;
    color: var(--color-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .prose {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prose > :global(*:first-child) {
    margin-top: 0;
  }

  .prose :global(img) {
    display: block;
    margin: 2rem auto;
  }

  .prose :global(pre) {
    position: relative;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 3rem;
  }

  .post-nav {
    margin-top: 4rem;
    font-size: 0.9375rem;
  }

  .post-nav a {
    color: var(--color-secondary);
    text-decoration: none;
  }

  .post-nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .prose {
      font-size: 1rem;
    }
  }
</style>
